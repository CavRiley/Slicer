        </item>
        <item>
         <widget class="QPushButton" name="nextButton">
          <property name="text">
           <string>Next ▶</string>
          </property>
          <property name="minimumHeight">
           <number>36</number>
          </property>
          <property name="toolTip">
           <string>Shortcut: Right arrow or N</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="nextPendingButton">
          <property name="text">
           <string>Next unreviewed</string>
          </property>
          <property name="minimumHeight">
           <number>36</number>
          </property>
          <property name="toolTip">
           <string>Shortcut: U</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="blendLayout">
        <item>
         <widget class="QLabel" name="blendLabel">
          <property name="text">
           <string>ADC ◀ ▶ TRACEW:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="ctkSliderWidget" name="blendSliderWidget">
          <property name="toolTip">
           <string>0 shows only the first image, 1 only the second. Same as the opacity slider in the view controllers. Shortcut: T</string>
          </property>
          <property name="decimals">
           <number>2</number>
          </property>
          <property name="singleStep">
           <double>0.1</double>
          </property>
          <property name="pageStep">
           <double>0.5</double>
