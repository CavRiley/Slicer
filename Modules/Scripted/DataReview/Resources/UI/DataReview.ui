      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QCheckBox" name="keepSlicePositionsCheckBox">
        <property name="text">
         <string>Keep slice positions when switching cases</string>
        </property>
        <property name="toolTip">
         <string>Assumes all images share the same physical space. Uncheck to fit each new case to the views.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
