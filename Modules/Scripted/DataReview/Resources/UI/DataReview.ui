        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="textInteractionFlags">
         <set>Qt::TextSelectableByMouse</set>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="commentLabel">
        <property name="text">
         <string>Comment (required when rejecting):</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPlainTextEdit" name="commentTextEdit">
        <property name="placeholderText">
         <string>Notes about this case. Saved automatically.</string>
        </property>
        <property name="maximumHeight">
         <number>90</number>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="rejectReasonLabel">
        <property name="text">
         <string>Please write a comment explaining why the case is rejected.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="decisionLayout">
        <item>
         <widget class="QPushButton" name="acceptButton">
          <property name="text">
           <string>✓  ACCEPT</string>
          </property>
          <property name="minimumHeight">
           <number>52</number>
          </property>
          <property name="toolTip">
           <string>Mark the case as accepted and move to the next one. Shortcut: A</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="rejectButton">
          <property name="text">
           <string>✗  REJECT</string>
          </property>
          <property name="minimumHeight">
           <number>52</number>
          </property>
          <property name="toolTip">
           <string>Mark the case as rejected (a comment is required) and move to the next one. Shortcut: R</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="navigationLayout">
        <item>
         <widget class="QPushButton" name="previousButton">
          <property name="text">
           <string>◀ Previous</string>
          </property>
          <property name="minimumHeight">
           <number>36</number>
          </property>
          <property name="toolTip">
           <string>Shortcut: Left arrow or P</string>
          </property>
