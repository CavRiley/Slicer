           <double>0.0</double>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="secondaryLayout">
        <item>
         <widget class="QPushButton" name="removeDecisionButton">
          <property name="text">
           <string>Remove decision</string>
          </property>
          <property name="toolTip">
           <string>Set this case back to unreviewed. The comment is kept.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="showSegmentationCheckBox">
          <property name="text">
           <string>Show segmentation</string>
          </property>
          <property name="toolTip">
           <string>Shortcut: S</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="resetViewsButton">
          <property name="text">
           <string>Reset views</string>
          </property>
          <property name="toolTip">
           <string>Re-center and re-fit both views on the current images.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="shortcutsLabel">
        <property name="text">
         <string>&lt;small&gt;Keys: &lt;b&gt;A&lt;/b&gt; accept, &lt;b&gt;R&lt;/b&gt; reject, &lt;b&gt;→&lt;/b&gt;/&lt;b&gt;←&lt;/b&gt; next/previous, &lt;b&gt;U&lt;/b&gt; next unreviewed, &lt;b&gt;S&lt;/b&gt; show/hide segmentation, &lt;b&gt;T&lt;/b&gt; switch ADC/TRACEW&lt;/small&gt;</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="datasetCollapsibleButton">
     <property name="text">
      <string>Dataset and setup</string>
     </property>
     <layout class="QFormLayout" name="datasetFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="manifestLabel">
        <property name="text">
         <string>Manifest file:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="manifestLayout">
        <item>
         <widget class="ctkPathLineEdit" name="manifestPathLineEdit">
          <property name="toolTip">
           <string>JSON file listing the cases and holding the review state (status, comment, reviewer).</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="loadManifestButton">
          <property name="text">
           <string>Load</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="reviewerLabel">
        <property name="text">
         <string>Reviewer:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="reviewerLineEdit">
        <property name="placeholderText">
         <string>Name or initials, stored with each decision</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="autoLoadCheckBox">
        <property name="text">
         <string>Open this manifest automatically when Slicer starts</string>
        </property>
        <property name="toolTip">
         <string>Together with setting Data Review as the home module (Edit, Application Settings, Modules), the review opens by itself at startup.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="simplifiedUICheckBox">
        <property name="text">
         <string>Simplified interface at startup (hide menus, toolbars, help)</string>
        </property>
        <property name="toolTip">
         <string>Takes effect the next time Slicer starts. Press Ctrl+Shift+U at any time to show or hide the full interface.</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="ctkCollapsibleGroupBox" name="scanGroupBox">
        <property name="title">
         <string>Create manifest from folder</string>
        </property>
        <property name="collapsed">
         <bool>true</bool>
        </property>
        <layout class="QFormLayout" name="scanFormLayout">
         <item row="0" column="0">
          <widget class="QLabel" name="rootLabel">
           <property name="text">
            <string>Dataset folder:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="ctkPathLineEdit" name="rootDirectoryLineEdit">
           <property name="toolTip">
            <string>Folder that contains the images and segmentations. Patterns below are relative to this folder.</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="adcPatternLabel">
           <property name="text">
            <string>ADC pattern:</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="adcPatternLineEdit">
           <property name="text">
            <string>adc/*.nii.gz</string>
           </property>
           <property name="toolTip">
            <string>Glob pattern (relative to the dataset folder) matching the ADC images. ** matches sub-folders. Leave empty if there is no ADC image.</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="tracewPatternLabel">
           <property name="text">
            <string>TRACEW pattern:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="tracewPatternLineEdit">
           <property name="text">
            <string>tracew/*.nii.gz</string>
           </property>
           <property name="toolTip">
            <string>Glob pattern matching the trace-weighted (DWI) images. Leave empty if there is no TRACEW image.</string>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="segmentationPatternLabel">
           <property name="text">
            <string>Segmentation pattern:</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QLineEdit" name="segmentationPatternLineEdit">
           <property name="text">
            <string>labels/*.nii.gz</string>
           </property>
           <property name="toolTip">
            <string>Glob pattern matching the lesion segmentation files. Files are paired with images by case name (suffixes such as _adc, _tracew, _seg are ignored).</string>
           </property>
          </widget>
         </item>
         <item row="4" column="0" colspan="2">
          <widget class="QPushButton" name="scanButton">
           <property name="text">
            <string>Scan folder and create manifest</string>
           </property>
           <property name="toolTip">
            <string>Scans the folder, writes review_manifest.json into it, and loads it. Existing decisions in that manifest are preserved.</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QCheckBox" name="advanceAfterDecisionCheckBox">
